  "query": "SELECT t.id, t.family_id, t.repo, t.created_ms, l.device_id AS \"device_id?\", l.epoch AS \"epoch?\", u.name AS owner,\n             t.visibility, t.made_on\n         FROM threads t\n         JOIN users u ON u.id = t.owner_id\n         LEFT JOIN leases l ON l.thread_id = t.id\n         ORDER BY t.created_ms",
