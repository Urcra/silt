+  describe("steering (_session/steering)", () => {
+    const STEER = [{ type: "text" as const, text: "Also check the docs" }];
+
+    /** Opens a session, and a turn of its first prompt. */
+    async function runningTurn(agent: v2.ClientContext) {
+      const { response, claude } = await openSession(agent);
+      const sessionId = response.sessionId;
+      const first = agent.request(v2.methods.agent.session.prompt, { sessionId, prompt: PROMPT });
+      claude.send(lifecycle(await claude.prompt(0), "started"));
+      await first;
+      return { sessionId, claude };
+    }
+
+    it.each([
+      ["now", undefined, "now"],
+      ["later while a permission request of the session awaits the user", null, "later"],
+      ["later while a permission request of a subagent awaits the user", "child", "later"],
+    ] as const)("injects into the running turn at priority %s", async (_, asker, priority) => {
+      const client = v2Client({ answerPermission: () => new Promise(() => {}) });
+      await client.connect(async (agent) => {
+        const { sessionId, claude } = await runningTurn(agent);
+        if (asker === "child") {
+          const child = subagent("child", "toolu_launch");
+          claude.send(child.launch());
+          claude.send(child.started());
+        }
+        if (asker !== undefined) {
+          const fields = asker === null ? {} : { agentID: asker };
+          void askPermission(claude, "Bash", { command: "ls" }, fields).catch(() => {});
+          await vi.waitFor(() => expect(client.permissionRequests).toHaveLength(1));
+        }
+
+        const response = await agent.request("_session/steering", { sessionId, prompt: STEER });
+
+        expect(response).toEqual({ outcome: "injected" });
+        const steered = await claude.prompt(1);
+        expect(steered).toMatchObject({
+          priority,
+          message: { role: "user", content: [{ type: "text", text: "Also check the docs" }] },
+          origin: { kind: "human" },
+        });
+        // Claude Code takes it into the turn: its echo sends its user message.
+        claude.send(echo(steered));
+        await vi.waitFor(() =>
+          expect(client.sessionUpdates).toContainEqual({
+            sessionUpdate: "user_message",
+            messageId: steered.uuid,
+            content: STEER,
+          }),
+        );
+      });
+    });
+
+    it.each([
+      ["no turn is open", false],
+      ["a cancel stops the open turn", true],
+    ])(
+      "answers promptRequired and pushes nothing when %s and the client opted in",
+      async (_, cancelled) => {
+        const client = v2Client();
+        await client.connect(async (agent) => {
+          let sessionId: string;
+          let claude: FakeClaudeCode;
+          if (cancelled) {
+            ({ sessionId, claude } = await runningTurn(agent));
+            await agent.notify(v2.methods.agent.session.cancel, { sessionId });
+            await vi.waitFor(() => expect(claude.interrupt).toHaveBeenCalled());
+          } else {
+            const opened = await openSession(agent);
+            sessionId = opened.response.sessionId;
+            claude = opened.claude;
+          }
+          const pushed = claude.prompts.length;
+
+          const response = await agent.request("_session/steering", {
+            sessionId,
+            prompt: STEER,
+            _meta: { steering: { idleBehavior: "promptRequired" } },
+          });
+
+          expect(response).toEqual({ outcome: "promptRequired", reason: "noRunningTurn" });
+          await new Promise((resolve) => setTimeout(resolve, 0));
+          expect(claude.prompts).toHaveLength(pushed);
+          expect(client.sessionUpdates).not.toContainEqual(
+            expect.objectContaining({ sessionUpdate: "user_message", content: STEER }),
