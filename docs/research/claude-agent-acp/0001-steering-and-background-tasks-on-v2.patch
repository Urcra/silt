 export const STEER_METHOD = "_session/steering";
 
 /** How urgently the SDK delivers a steered message relative to the running
@@ -15,6 +17,15 @@ export const STEER_METHOD = "_session/steering";
 export const STEER_PRIORITY_NOW = "now" as const;
 export const STEER_PRIORITY_LATER = "later" as const;
 
+/** The priority of a steered message: `later` while a permission request or
+ *  elicitation of the session or of one of its subagents awaits the user,
+ *  `now` otherwise. */
+export function steerPriority(
+  userInputOpen: boolean,
+): typeof STEER_PRIORITY_NOW | typeof STEER_PRIORITY_LATER {
+  return userInputOpen ? STEER_PRIORITY_LATER : STEER_PRIORITY_NOW;
+}
+
 /** Request-level steering options. `promptRequired` is opt-in so existing Hosts
  *  keep the established idle fallback behavior. */
 type SteerMeta = {
@@ -25,12 +36,14 @@ type SteerMeta = {
 };
 
 /** Params of a {@link STEER_METHOD} request. Shaped like the relevant subset of
- *  a `PromptRequest` so the same `promptToClaude` conversion applies. Delivery
+ *  a `PromptRequest` so the same `promptToClaude` conversion applies. `Prompt`
+ *  is the content of the protocol version's `PromptRequest`: v1's by default,
+ *  v2's on the v2 core, which converts it as it converts a prompt. Delivery
  *  priority is deliberately NOT exposed here — it's an internal detail the agent
- *  chooses (see {@link STEER_PRIORITY}). */
-export type SteerRequest = {
+ *  chooses (see {@link steerPriority}). */
+export type SteerRequest<Prompt = PromptRequest["prompt"]> = {
   sessionId: string;
-  prompt: PromptRequest["prompt"];
+  prompt: Prompt;
   _meta?: SteerMeta | null;
 };
 
@@ -42,10 +55,20 @@ export type SteerResponse =
   | { outcome: "startedNewTurn" }
   | { outcome: "promptRequired"; reason: "noRunningTurn" };
 
+/** Whether the request opted into the `promptRequired` result for a session
+ *  with no running turn. */
+export function promptRequiredWhenIdle(request: SteerRequest<unknown>): boolean {
+  return request._meta?.steering?.idleBehavior === "promptRequired";
+}
+
 /** Validate raw JSON-RPC params into a {@link SteerRequest}. Kept minimal — the
- *  content blocks are handed to `promptToClaude`, which tolerates unknown block
- *  types — but `sessionId` and a non-empty `prompt` array are required. */
-export function parseSteerRequest(params: unknown): SteerRequest {
+ *  content blocks are handed to the core's prompt conversion (v1:
+ *  `promptToClaude`, which tolerates unknown block types; v2: `v1PromptRequest`,
+ *  which rejects them as for a prompt) — but `sessionId` and a non-empty
+ *  `prompt` array are required. */
+export function parseSteerRequest<Prompt = PromptRequest["prompt"]>(
+  params: unknown,
+): SteerRequest<Prompt> {
   if (!params || typeof params !== "object") {
     throw RequestError.invalidParams(undefined, "steer params must be an object");
   }
@@ -67,7 +90,7 @@ export function parseSteerRequest(params: unknown): SteerRequest {
   }
   return {
     sessionId,
-    prompt: prompt as PromptRequest["prompt"],
+    prompt: prompt as Prompt,
     _meta: _meta as SteerMeta | null | undefined,
   };
 }
