+/**
+ * `_claude/background_tasks`: the v2 core's request for Claude Code's
+ * `Query.backgroundTasks`, which moves foreground Bash commands and
+ * subagents to the background, as Ctrl+B does in Claude Code's terminal.
+ * Each blocking tool call then returns with a "running in the background"
+ * result, the turn goes on, and so does the task.
+ *
+ * Advertised in the `initialize` response as the top-level
+ * `_meta.claudeCode.backgroundTasks = {supported: true}`.
+ */
+import { RequestError } from "@agentclientprotocol/sdk/unstable";
+
+export const BACKGROUND_TASKS_METHOD = "_claude/background_tasks";
+
+/** The `initialize` response `_meta` that advertises {@link BACKGROUND_TASKS_METHOD}. */
+export const BACKGROUND_TASKS_CAPABILITY = { supported: true } as const;
+
+/**
+ * Params of a {@link BACKGROUND_TASKS_METHOD} request. Without `toolCallId`,
+ * every foreground task of the session moves. With it, only the task that
+ * the tool call started: a tool call's id is the id of Claude's `tool_use`
+ * block.
+ */
+export type BackgroundTasksRequest = {
+  sessionId: string;
+  toolCallId?: string;
+};
+
+/** `backgrounded` is `false` only for a `toolCallId` that started no foreground task. */
+export type BackgroundTasksResponse = { backgrounded: boolean };
+
+export function parseBackgroundTasksRequest(params: unknown): BackgroundTasksRequest {
+  if (!params || typeof params !== "object") {
+    throw RequestError.invalidParams(undefined, "background_tasks params must be an object");
+  }
+  const { sessionId, toolCallId } = params as Record<string, unknown>;
+  if (typeof sessionId !== "string" || sessionId.length === 0) {
+    throw RequestError.invalidParams(
+      undefined,
+      "background_tasks params require a non-empty sessionId",
+    );
+  }
+  if (toolCallId != null && (typeof toolCallId !== "string" || toolCallId.length === 0)) {
+    throw RequestError.invalidParams(
+      { sessionId },
+      "background_tasks `toolCallId` must be a non-empty string",
+    );
+  }
+  return { sessionId, ...(typeof toolCallId === "string" ? { toolCallId } : {}) };
+}
